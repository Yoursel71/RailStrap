<base:WpfUiWindow x:Class="RailStrap.UI.Elements.Dialogs.ChangelogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:RailStrap.UI.Elements.Base"
        xmlns:controls="clr-namespace:RailStrap.UI.Elements.Controls"
        xmlns:local="clr-namespace:RailStrap.UI.Elements.Dialogs"
        xmlns:resources="clr-namespace:RailStrap.Resources"
        mc:Ignorable="d"
        Title="{Binding ElementName=TitleText, Path=Text}"
        Width="540"
        MaxHeight="600"
        MinHeight="0"
        SizeToContent="Height"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Padding="8" x:Name="RootTitleBar" ShowMinimize="False" ShowMaximize="False" CanMaximize="False" KeyboardNavigation.TabNavigation="None" Title="{Binding ElementName=TitleText, Path=Text}" />

        <ScrollViewer Grid.Row="1" Margin="16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="18" Margin="0,0,0,16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                <controls:MarkdownTextBlock x:Name="BodyMDTextBlock" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="15" Background="{ui:ThemeResource SolidBackgroundFillColorSecondaryBrush}">
            <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Right">
                <Button x:Name="CloseButton" MinWidth="100" Content="{x:Static resources:Strings.Common_Close}" />
            </StackPanel>
        </Border>
    </Grid>
</base:WpfUiWindow>
