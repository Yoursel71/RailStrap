<Window x:Class="RailStrap.UI.Elements.Overlay.PingOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RailStrap Ping Overlay"
        Width="120"
        Height="36"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <Border Background="#B0101010" CornerRadius="6" Padding="10,4">
        <TextBlock x:Name="PingText" Text="Ping: -- ms" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
</Window>
